<div class="sort-controls">
  <span>Sort:</span>
  <%= action_button "A-Z", url_for(action: sort_action, sort_by: "name", direction: "asc"),
      class: "sort-link" %>
  <%= action_button "Z-A", url_for(action: sort_action, sort_by: "name", direction: "desc"),
      class: "sort-link" %>
  <%= action_button "Oldest", url_for(action: sort_action, sort_by: "created_at", direction: "asc"),
      class: "sort-link" %>
  <%= action_button "Newest", url_for(action: sort_action, sort_by: "created_at", direction: "desc"),
      class: "sort-link" %>
</div>
